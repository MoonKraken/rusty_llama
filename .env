# Hugging Face GGUF. The first server start downloads this into the HF cache
# (~/.cache/huggingface) when it is not already there. Q4_K_M is about 17 GB.
MODEL_REPO=bartowski/Qwen3.8-27B-GGUF
MODEL_FILE=Qwen3.8-27B-Q4_K_M.gguf

# Optional local override. A .gguf file or a directory of shards. Leave unset
# to use the repo above.
# MODEL_PATH=/path/to/model.gguf
# Optional chat template when the GGUF does not embed one.
# CHAT_TEMPLATE=/path/to/chat_template.json
